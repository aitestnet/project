# ──────────────────────────────────────────────────
# Teskel — Local Development Environment
# ──────────────────────────────────────────────────

# ─── AI Providers ───
# Leave empty to use mock/deterministic chat
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# ─── Database ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/teskel

# ─── Auth (Clerk) ───
# Leave empty to disable auth (dashboard accessible without login)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Payments (Stripe) ───
# Leave empty to disable payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Email (Resend) ───
RESEND_API_KEY=

# ─── Storage ───
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=teskel

# ─── Dokploy Runtime ───
DOKPLOY_API_URL=
DOKPLOY_API_TOKEN=

# ─── Search ───
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=teskel-dev-key

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
