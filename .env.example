# ──────────────────────────────────────────────────
# Teskel — Environment Variables
# Copy to .env.local and fill in your values
# ──────────────────────────────────────────────────

# ─── AI Providers ───
# At least one is required for real AI chat.
# If none are set, the mock/deterministic chat will be used.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: LiteLLM proxy URL (if self-hosting LiteLLM)
# LITELLM_API_BASE=http://localhost:4000

# AI model to use (default: gpt-4o-mini)
AI_MODEL=gpt-4o-mini

# ─── Database ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teskel
REDIS_URL=redis://localhost:6379

# ─── Auth (Clerk) ───
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# ─── Payments (Stripe) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ─── Email (Resend) ───
RESEND_API_KEY=
EMAIL_FROM=noreply@teskel.app

# ─── Storage (MinIO / R2) ───
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=teskel

# ─── Dokploy Runtime ───
DOKPLOY_API_URL=
DOKPLOY_API_TOKEN=

# ─── Search (Meilisearch) ───
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=

# ─── Analytics ───
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Monitoring ───
SENTRY_DSN=

# ─── App ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
