# ─── Core ──────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://teskel.app

# ─── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://teskel:changeme@localhost:5433/teskel

# ─── Auth (Clerk) ─────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

# ─── AI ───────────────────────────────────────────────
OPENAI_API_KEY=sk-xxx
AI_MODEL=gpt-4o-mini

# ─── Payments (Stripe) ────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# ─── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=re_xxx
EMAIL_FROM=Teskel <noreply@teskel.app>

# ─── Vector DB (Qdrant) ───────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ─── Cache (Redis) ────────────────────────────────────
REDIS_URL=redis://:changeme@localhost:6379

# ─── Deployment (Dokploy) ─────────────────────────────
DOKPLOY_API_URL=https://deploy.teskel.app
DOKPLOY_API_TOKEN=xxx

# ─── Analytics (PostHog) ──────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phx_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Storage (MinIO) ──────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=teskel
MINIO_SECRET_KEY=changeme123
MINIO_BUCKET=teskel-assets

# ─── Docker Compose ───────────────────────────────────
POSTGRES_USER=teskel
POSTGRES_PASSWORD=changeme
POSTGRES_DB=teskel
REDIS_PASSWORD=changeme
MINIO_ROOT_USER=teskel
MINIO_ROOT_PASSWORD=changeme123
